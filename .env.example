# ── Docker PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=yarc
POSTGRES_USER=yarc
POSTGRES_PASSWORD=yarc
POSTGRES_PORT=5432

# ── Application Database URL ─────────────────────────────────────────────────
DATABASE_URL=postgresql://yarc:yarc@localhost:5432/yarc

# ── Authentication ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
PASSWORD_HASH=

# ── External Services ────────────────────────────────────────────────────────
MINERU_API_URL=http://localhost:8000
EMBEDDING_API_URL=http://localhost:15263/v1/embeddings
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1536

# ── Search API Keys ──────────────────────────────────────────────────────────
# IEEE Xplore: https://developer.ieee.org/
IEEE_API_KEY=

# Semantic Scholar (optional, improves rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# ── Pi Agent ─────────────────────────────────────────────────────────────────
PI_CLI_COMMAND=pi
PI_CHAT_TOOLS=all
PI_CHAT_TIMEOUT_MS=120000
PI_RUNTIME_IDLE_TTL_MS=900000
PI_RUNTIME_MAX_ACTIVE=12
PI_RUNTIME_START_TIMEOUT_MS=30000
PI_RUNTIME_JOURNAL_RETENTION_MS=86400000
PI_EXTENSION_UI_TIMEOUT_MS=300000
PI_SESSION_DURABILITY=strict
SUMMARY_TIMEOUT_MS=300000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
