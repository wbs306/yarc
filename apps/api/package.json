{
  "name": "@yarc/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "pretypecheck": "pnpm --filter @yarc/db generate",
    "typecheck": "tsc --rootDir ../.. --noEmit",
